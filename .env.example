# ---------------------------------------------------------------------------
# LFES Avia — Environment Variables (Phase 1)
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key. Bypasses Row Level Security — never expose to the browser.
# Used only in server-side admin operations / webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --------------------------------------------------------------------
# Public base URL of the deployed app (used for auth redirects, emails, bot links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI Concierge (Milestone 3) --------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram Bot (Milestone 3) --------------------------------------------
TELEGRAM_BOT_TOKEN=
# Secret used to validate incoming Telegram webhook calls
TELEGRAM_WEBHOOK_SECRET=
